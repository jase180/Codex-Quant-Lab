{
  "description": "Enter when close breaks above the prior 20-close high and exit when close breaks below the prior 10-close low.",
  "entry": {
    "conditions": [
      {
        "left": {
          "price": "close"
        },
        "operator": "gt",
        "right": {
          "indicator": "high_20"
        }
      }
    ],
    "when": "all"
  },
  "exit": {
    "conditions": [
      {
        "left": {
          "price": "close"
        },
        "operator": "lt",
        "right": {
          "indicator": "low_10"
        }
      }
    ],
    "when": "all"
  },
  "indicators": [
    {
      "id": "high_20",
      "inputs": {
        "length": 20,
        "source": "close"
      },
      "kind": "rolling_high"
    },
    {
      "id": "low_10",
      "inputs": {
        "length": 10,
        "source": "close"
      },
      "kind": "rolling_low"
    }
  ],
  "market": {
    "symbol": "SPY",
    "timeframe": "1d"
  },
  "name": "SPY Donchian 20/10 long/cash",
